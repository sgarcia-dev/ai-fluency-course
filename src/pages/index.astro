---
import Base from '../preview/designs/subway-v2/Base.astro';
import Station from '../preview/designs/subway-v2/Station.astro';
import { site } from '../preview/content';
import { lines, goals } from '../preview/designs/subway-v2/data';
const data = { lines: lines.map((l) => ({ id: l.id, name: l.name, color: l.color, ink: l.ink, count: l.stops.length, minutes: l.minutes, first: l.first, ns: l.stops.map((s) => s.n) })), goals };
---
<Base title={`${site.name}: the map`}>
<header class="hero wrap">
	<p class="mono kicker">A free course by {site.author.name}</p>
	<h1>{site.name}</h1>
	<p class="tag display">{site.tagline}</p>
	<p class="pitch">{site.pitch}</p>
	<p class="status"><span class="mono">Status</span> {site.status}</p>
	<p><a class="btn ink" href="#pick">Find your line</a></p>
</header>

<main id="main" data-v2={JSON.stringify(data)}>
	<section id="pick" class="wrap pick" aria-live="polite">
		<div class="step" id="step1">
			<p class="mono">Step 1 of 2</p>
			<h2>What do you want AI to help you with?</h2>
			<ul class="goals">
				{goals.map((g) => <li><button type="button" class="goal" data-goal={g.id}>{g.label}</button></li>)}
			</ul>
		</div>
		<div class="step" id="step2" hidden>
			<p class="mono">Step 2 of 2</p>
			<h2>Which sounds most like you today?</h2>
			<ul class="stories">
				{lines.map((l) => (
					<li><button type="button" class="story" data-path={l.id} style={`--c:${l.color}`}><span class="sw" aria-hidden="true"></span><q>{l.story}</q></button></li>
				))}
			</ul>
			<button type="button" class="linkbtn" id="back1">Back to step 1</button>
		</div>
		<div class="ticket" id="ticket" hidden>
			<div class="tk-band" id="tk-band"><span class="mono">Your line</span><span class="tk-name display" id="tk-name"></span></div>
			<div class="tk-body">
				<p class="mono" id="tk-meta"></p>
				<p id="tk-goal"></p>
				<p class="tk-act"><a class="btn ink" id="tk-start" href="#line">Start at stop 1</a> <button type="button" class="linkbtn" id="tk-change">Change</button></p>
			</div>
		</div>
	</section>

	<section id="map" class="wrap map" aria-labelledby="map-h">
		<h2 id="map-h">The map</h2>
		<p class="lede">Four lines. Each is a path through the course. A lesson that fits more than one path is a stop on each line. Hover, focus or tap any stop to preview it.</p>
		<div class="overview">
			{lines.map((l) => (
				<div class="row" data-line={l.id} style={`--c:${l.color}`}>
					<p class="rname"><span class="mono">{l.stops.length} stops</span> {l.name}</p>
					<ol class="track">{l.stops.map((s) => <Station s={s} line={`o-${l.id}`} />)}</ol>
				</div>
			))}
		</div>

		<div id="line" class="chosen">
			<p class="empty" id="empty">Pick your line above, and it shows here, stop by stop.</p>
			{lines.map((l) => (
				<div class="route" data-line={l.id} style={`--c:${l.color};--k:${l.ink}`} hidden>
					<h3><span class="bar" aria-hidden="true"></span>{l.name} line</h3>
					<ol class="vline">{l.stops.map((s) => <Station s={s} line={`v-${l.id}`} big />)}</ol>
				</div>
			))}
		</div>
	</section>

	<section class="wrap prose" aria-labelledby="why-h">
		<h2 id="why-h">Why this exists</h2>
		{site.why.map((p) => <p>{p}</p>)}
	</section>
	<section class="wrap" aria-labelledby="diff-h">
		<h2 id="diff-h">How it is different</h2>
		<ul class="diff">{site.different.map((d) => <li><h3>{d.title}</h3><p>{d.body}</p></li>)}</ul>
	</section>
	<section class="wrap prose author" aria-labelledby="au-h">
		<h2 id="au-h">Who made this</h2>
		<p>{site.author.story}</p>
		<p><a href={site.author.url}>{site.author.name}</a></p>
	</section>
	<section class="wrap prose fb" aria-labelledby="fb-h">
		<h2 id="fb-h">Tell me what you think</h2>
		<p>Saw this at a meetup? I would love to hear what confused you, what you would skip, and what you wish was here.</p>
		<p><a class="btn" href={site.feedbackUrl}>Send feedback</a></p>
	</section>
</main>

<script>
	const main = document.getElementById('main')!;
	const D = JSON.parse(main.dataset.v2!);
	const $ = (id: string) => document.getElementById(id)!;
	const get = (k: string) => { try { return localStorage.getItem(k) || ''; } catch { return ''; } };
	const set = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };
	let goal = get('aip-goal');

	function show(step: 'step1' | 'step2' | 'ticket') {
		for (const s of ['step1', 'step2', 'ticket']) $(s).hidden = s !== step;
	}
	function render(pathId: string, scroll = false) {
		const L = D.lines.find((l: any) => l.id === pathId);
		if (!L) { show('step1'); return; }
		const g = D.goals.find((x: any) => x.id === goal);
		const hl: number[] = g ? g.tied.filter((n: number) => L.ns.includes(n)).slice(0, 3) : [];
		$('tk-band').style.cssText = `background:${L.color};color:${L.ink}`;
		$('tk-name').textContent = L.name;
		$('tk-meta').textContent = `${L.count} stops · about ${Math.round(L.minutes / 5) * 5} minutes in all`;
		$('tk-goal').textContent = g ? `You want to ${g.want}. ${hl.length ? 'The stops marked on your line help most with that.' : 'This line builds the skills for that.'}` : 'This line fits where you are today.';
		const a = $('tk-start') as HTMLAnchorElement;
		a.href = L.first || '#line';
		show('ticket');
		document.querySelectorAll<HTMLElement>('.route').forEach((r) => (r.hidden = r.dataset.line !== pathId));
		document.querySelectorAll<HTMLElement>('.row').forEach((r) => r.classList.toggle('on', r.dataset.line === pathId));
		document.querySelectorAll<HTMLElement>('.route .st').forEach((s) => s.classList.toggle('hl', hl.includes(Number(s.dataset.n))));
		main.classList.add('picked');
		$('empty').hidden = true;
		if (scroll) $('ticket').scrollIntoView({ block: 'start' });
	}
	document.querySelectorAll<HTMLButtonElement>('.goal').forEach((b) => b.addEventListener('click', () => {
		goal = b.dataset.goal!;
		set('aip-goal', goal);
		const g = D.goals.find((x: any) => x.id === goal);
		if (g) set('aip-world', g.world);
		show('step2');
		($('step2').querySelector('h2') as HTMLElement).setAttribute('tabindex', '-1');
		($('step2').querySelector('h2') as HTMLElement).focus();
	}));
	document.querySelectorAll<HTMLButtonElement>('.story').forEach((b) => b.addEventListener('click', () => {
		set('aip-path', b.dataset.path!);
		render(b.dataset.path!, true);
		$('tk-name').setAttribute('tabindex', '-1'); $('tk-name').focus();
	}));
	$('back1').addEventListener('click', () => show('step1'));
	$('tk-change').addEventListener('click', () => { show('step1'); (document.querySelector('.goal') as HTMLElement).focus(); });
	render(get('aip-path'));

	// Preview cards: hover and focus are CSS. Tap toggles; Escape closes.
	document.querySelectorAll<HTMLElement>('.st').forEach((st) => {
		const b = st.querySelector('button')!;
		b.addEventListener('click', () => {
			const open = !st.classList.contains('open');
			document.querySelectorAll('.st.open').forEach((x) => { x.classList.remove('open'); x.querySelector('button')!.setAttribute('aria-expanded', 'false'); });
			st.classList.toggle('open', open); b.setAttribute('aria-expanded', String(open));
		});
		st.addEventListener('keydown', (e) => { if (e.key === 'Escape') { st.classList.add('shut'); b.focus(); } });
		st.addEventListener('focusout', () => st.classList.remove('shut'));
		st.addEventListener('mouseleave', () => st.classList.remove('shut'));
	});
	document.addEventListener('click', (e) => {
		if (!(e.target as HTMLElement).closest('.st')) document.querySelectorAll('.st.open').forEach((x) => x.classList.remove('open'));
	});
</script>

<style is:global>
	.wrap{max-width:68rem;margin:0 auto;padding:3.5rem 1.25rem}
	.hero{padding-top:4rem}
	.kicker{margin:0 0 1rem}
	.hero h1{font-size:clamp(3rem,13vw,8.5rem)}
	.tag{font-size:clamp(1.6rem,5vw,2.6rem);margin:.6rem 0 1.2rem}
	.pitch{font-size:1.25rem;max-width:36rem}
	.status{max-width:36rem;border-left:6px solid #FFD400;padding:.2rem 0 .2rem .8rem}
	.status .mono{display:block}
	h2{font-size:clamp(2rem,6vw,3.2rem);margin-bottom:1.2rem}
	.pick{border-top:3px solid #0A0A0A}
	.goals,.stories{list-style:none;margin:0 0 1rem;padding:0;display:grid;gap:1rem;grid-template-columns:repeat(auto-fill,minmax(15rem,1fr))}
	.goal,.story{width:100%;height:100%;text-align:left;font:500 1.05rem/1.4 'Space Grotesk',sans-serif;color:#0A0A0A;background:#fff;border:3px solid #0A0A0A;box-shadow:4px 4px 0 #0A0A0A;padding:1rem;cursor:pointer;min-height:5rem}
	.goal:hover,.story:hover{background:#FFF6C2}
	.goal:active,.story:active{box-shadow:none;transform:translate(4px,4px)}
	.stories{grid-template-columns:repeat(auto-fill,minmax(20rem,1fr))}
	@media (max-width:30rem){.stories{grid-template-columns:1fr}}
	.story{display:flex;gap:.8rem}
	.story q{quotes:none}
	.sw{flex:none;width:12px;align-self:stretch;background:var(--c);outline:1px solid #0A0A0A}
	.ticket{max-width:34rem;border:3px solid #0A0A0A;box-shadow:4px 4px 0 #0A0A0A}
	.tk-band{padding:1rem 1.2rem;border-bottom:3px solid #0A0A0A;display:flex;flex-direction:column}
	.tk-name{font-size:clamp(1.8rem,7vw,2.6rem)}
	.tk-body{padding:.4rem 1.2rem 1rem;border-top:3px dashed #0A0A0A;margin-top:6px}
	.tk-act{display:flex;flex-wrap:wrap;gap:1rem;align-items:center}
	.map{border-top:3px solid #0A0A0A}
	.lede{max-width:40rem}
	.overview{display:grid;gap:1.4rem;margin:2rem 0 3rem}
	.row{opacity:.55}
	.picked .row.on,.row:hover,.row:focus-within,main:not(.picked) .row{opacity:1}
	.rname{margin:0 0 .3rem;font-weight:700}
	.rname .mono{margin-right:.5rem}
	.track{list-style:none;margin:0;padding:0;display:flex;justify-content:space-between;position:relative}
	.track::before{content:"";position:absolute;left:10px;right:10px;top:13px;height:8px;background:var(--c);outline:1px solid #0A0A0A}
	.st{position:relative}
	.stb{position:relative;display:flex;flex-direction:column;align-items:center;gap:.2rem;background:none;border:0;padding:3px;cursor:pointer;color:#0A0A0A;font:inherit;text-align:left}
	.dot{width:28px;height:28px;border-radius:50%;background:#fff;border:5px solid #0A0A0A}
	.stb:hover .dot,.st.open .dot{background:#FFD400}
	.num{font-size:.75rem}
	.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
	.card{display:none;position:absolute;z-index:5;top:100%;left:50%;transform:translateX(-50%);width:18rem;max-width:80vw;background:#fff;border:3px solid #0A0A0A;box-shadow:4px 4px 0 #0A0A0A;padding:.8rem 1rem;font-size:.95rem}
	.track .st:first-child .card,.track .st:nth-child(2) .card{left:0;transform:none}
	.track .st:last-child .card,.track .st:nth-last-child(2) .card{left:auto;right:0;transform:none}
	.st:hover .card,.st:focus-within .card,.st.open .card{display:block}
	.st.shut .card{display:none}
	.card p{margin:0 0 .4rem}.ct{font-weight:700;font-size:1.05rem}
	.card ul{margin:.2rem 0 .7rem;padding-left:1.1rem}
	.soon{color:#3a3a3a}
	.chosen h3{font-size:clamp(1.8rem,5vw,2.6rem);display:flex;align-items:center;gap:.8rem;margin-bottom:1.2rem}
	.bar{width:2.5rem;height:14px;background:var(--c);outline:1px solid #0A0A0A}
	.vline{list-style:none;margin:0;padding:0;position:relative}
	.vline::before{content:"";position:absolute;left:21px;top:20px;bottom:20px;width:14px;background:var(--c);outline:1px solid #0A0A0A}
	.vline .st{padding:.5rem 0}
	.vline .stb{flex-direction:row;align-items:flex-start;gap:1rem;width:100%;max-width:44rem}
	.vline .dot{flex:none;width:42px;height:42px;border-width:6px;margin-left:7px}
	.vline .num{position:absolute;left:3px;top:52px;width:56px;text-align:center}
	.txt{display:flex;flex-direction:column;padding-top:.3rem}
	.txt .t{font:900 1.3rem/1.2 'Fraunces',serif;letter-spacing:-.01em}
	.txt .i{color:#333}
	.goalmark{display:none;align-self:flex-start;margin-top:.3rem;background:#FFD400;border:2px solid #0A0A0A;padding:.1rem .4rem;font-size:.7rem}
	.st.hl .goalmark{display:inline-block}
	.st.hl .dot{background:#FFD400}
	.vline .card{left:4.5rem;transform:none;top:calc(100% - .4rem)}
	.diff{list-style:none;padding:0;margin:0;display:grid;gap:1.2rem;grid-template-columns:repeat(auto-fill,minmax(16rem,1fr))}
	.diff li{border:3px solid #0A0A0A;padding:1rem}
	.diff h3{font-size:1.4rem;margin-bottom:.4rem}
	.prose p{max-width:40rem;font-size:1.1rem}
	@media (max-width:40rem){
		.picked .overview{display:none}
		.overview .row{overflow:hidden}
		.overview .card{display:none!important}
		.track .dot{width:20px;height:20px;border-width:4px}.track::before{top:9px;height:6px}.track .stb{padding:1px}
		.vline .card{left:0;width:auto;right:0;max-width:none}
	}
</style>
</Base>
