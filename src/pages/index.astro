---
import Base from '../preview/designs/subway-v2/Base.astro';
import { site, paths, samples } from '../preview/content';
import { starts } from '../preview/route';
import { pickGoals } from '../preview/picker';
import { stop, colorFor, inkOn, network, mobileNetwork } from '../preview/designs/subway-v2/data';
const N = network();
const M = mobileNetwork();
const colorWord: Record<string, string> = { new: 'Yellow', 'hit-or-miss': 'Orange', daily: 'Blue', builder: 'Purple' };
const lessons = Object.fromEntries(N.stations.map((s) => { const { n, ...rest } = stop(s.n); return [n, rest]; }));
const lineInfo = Object.fromEntries(paths.map((p) => [p.id, { name: p.name, color: colorFor(p.id), ink: inkOn(p.id), word: colorWord[p.id], lessons: p.lessons, story: starts.find((s) => s.id === p.id)?.story ?? p.says }]));
const data = { lessons, lines: lineInfo };
const sampleCards = samples.map((s) => ({ ...stop(s.n), ids: paths.filter((p) => p.lessons.includes(s.n)).map((p) => p.id) }));
const most = [
	'One long course for everyone, whatever you already know.',
	'Built around one app, so it goes stale in a few months.',
	'Hours of video before you try anything yourself.',
	'Reaching for the biggest, priciest model by default.',
	'A paywall or an upsell waiting at the end.',
];
const xEnd = (t: { pts: number[] }) => Math.max(...t.pts);
---
<Base title={`${site.name}: the map`}>
<header class="hero wrap">
	<p class="mono kicker">A free course by {site.author.name}</p>
	<h1>{site.name}</h1>
	<p class="tag display">{site.tagline}</p>
	<p class="pitch">{site.pitch}</p>
	<p class="status"><span class="mono">Status</span> {site.status}</p>
	<p><a class="btn ink" href="#plan">Find your line</a></p>
</header>

<main id="main" data-v4={JSON.stringify(data)}>
	<section id="plan" class="wrap pick" aria-live="polite">
		<div class="step" id="step1">
			<p class="mono">Step 1 of 2</p>
			<h2 tabindex="-1">Where do you want to get to?</h2>
			<p>Pick the one that matters most to you.</p>
			<ul class="goals">
				{pickGoals.map((g) => <li><button type="button" class="goal lift" data-goal={g.id} aria-pressed="false">{g.label}</button></li>)}
			</ul>
			<p class="mono teaser" id="teaser">Your line and its stops appear here.</p>
		</div>
		<div class="step" id="step2" hidden>
			<p class="mono">Step 2 of 2</p>
			<h2 tabindex="-1">Where are you with that today?</h2>
			<p>Pick the one that sounds most like you.</p>
			<ul class="stories" id="stories"></ul>
			<button type="button" class="linkbtn" id="back1">Back to step 1</button>
		</div>
		<div class="ticket" id="ticket" hidden>
			<div class="tk-band" id="tk-band"><span class="mono">Your line</span><span class="tk-name display" id="tk-name" tabindex="-1"></span></div>
			<div class="tk-body">
				<p id="tk-skip" hidden></p>
				<p><span class="mono">You said</span><br /><q id="tk-from"></q></p>
				<p><span class="mono">Heading for</span><br /><span id="tk-to"></span></p>
				<p class="mono" id="tk-meta"></p>
				<p class="tk-act"><a class="btn ink" id="tk-start" href="#stops">See your stops</a> <button type="button" class="linkbtn" id="tk-over">Start over</button></p>
				<p class="mono">Try another line</p>
				<div class="chips" id="chips">
					{paths.map((p) => <button type="button" class="chip" data-line={p.id} aria-pressed="false" style={`--c:${colorFor(p.id)};--k:${inkOn(p.id)}`}>{p.name}</button>)}
				</div>
			</div>
		</div>
	</section>

	<section id="map" class="wrap map" aria-labelledby="map-h" hidden>
		<h2 id="map-h">The map</h2>
		<p class="lede" id="legend">Each colored line is one path through the course. Where lines cross, they share a lesson.</p>
		<ul class="keys">{paths.map((p) => <li data-line={p.id}><span class="bar" style={`--c:${colorFor(p.id)}`} aria-hidden="true"></span>{colorWord[p.id]} line: {p.name}</li>)}</ul>
		<figure class="net" aria-hidden="true">
			<svg viewBox={`0 0 ${N.width + 40} ${N.baseY + 10}`}>
				{N.tracks.map((t) => (
					<g class="ln" data-line={t.id} style={`--c:${t.color}`}>
						{t.id === 'new' && <polyline class="edge" points={`${Math.min(...t.pts)},${t.y} ${xEnd(t)},${t.y}`} />}
						<polyline class="trk" pathLength="1" points={`${Math.min(...t.pts)},${t.y} ${xEnd(t)},${t.y}`} />
						{t.pts.map((x, i) => <circle class="dot" cx={x} cy={t.y} r="8" style={`--i:${i}`} />)}
					</g>
				))}
			</svg>
		</figure>
		<figure class="mnet" aria-hidden="true">
			<ul class="mhead">{paths.map((p) => <li class="mh" data-line={p.id} style={`--c:${colorFor(p.id)}`}><span class="mono">{colorWord[p.id]}</span>{p.name}</li>)}</ul>
			<svg viewBox={`0 0 ${M.width} ${M.height}`} preserveAspectRatio="xMidYMin meet">
				{M.cols.map((c) => (
					<g class="ln mln" data-line={c.id} style={`--c:${c.color}`}>
						<line class="trk" pathLength="1" x1={c.x} y1={c.y0} x2={c.x} y2={c.y1} />
						{c.ys.map((y, i) => <circle class="dot" cx={c.x} cy={y} r="6" style={`--i:${i}`} />)}
					</g>
				))}
			</svg>
		</figure>

		<div id="stops" class="chosen" hidden>
			<h3 id="stops-h">Your stops</h3>
			<p class="lede">Stops marked <span class="ready mono">Sample ready</span> can be read today. Tap any stop to see what it covers.</p>
			<ol class="vline" id="vlist"></ol>
		</div>
	</section>

	{sampleCards.length > 0 && <section class="wrap samples" aria-labelledby="smp-h">
		<h2 id="smp-h">Sample lessons</h2>
		<p class="lede">These lessons are ready to read now. The dots show which lines they sit on.</p>
		<ul class="scards">{sampleCards.map((s) => (
			<li><a class="scard lift" href={s.href}>
				<span class="sdots" aria-label={`On the ${s.ids.map((id) => colorWord[id]).join(', ')} line${s.ids.length > 1 ? 's' : ''}`}>{s.ids.map((id) => <span class="sdot" style={`--c:${colorFor(id)}`}></span>)}</span>
				<span class="t">{s.title}</span>
				<span>{s.idea}</span>
				<span class="mono">{s.minutes || 10} min</span>
			</a></li>
		))}</ul>
	</section>}
	<section class="wrap prose" aria-labelledby="why-h">
		<h2 id="why-h">Why this exists</h2>
		{site.why.map((p) => <p>{p}</p>)}
	</section>
	<section class="wrap" aria-labelledby="diff-h">
		<h2 id="diff-h">How it is different</h2>
		<p class="lede">Here are a few mistakes I see AI courses and trainings make, and what this one does instead. Tap a card to flip it.</p>
		<ul class="diff">{site.different.map((d, i) => (
			<li><button type="button" class="flip lift" aria-pressed="false">
				<span class="face a"><span class="mono">The mistake</span><span class="ft">{most[i] ?? ''}</span></span>
				<span class="face b"><span class="mono">What this one does</span><span class="ft display">{d.title}</span><span>{d.body}</span></span>
			</button></li>
		))}</ul>
	</section>
	<section class="wrap prose author" aria-labelledby="au-h">
		<h2 id="au-h">Who made this</h2>
		<p>{site.author.story}</p>
		<p><a href={site.author.url}>{site.author.name}</a></p>
	</section>
	<section class="wrap prose fb" aria-labelledby="fb-h">
		<h2 id="fb-h">Tell me what you think</h2>
		<p>Saw this at a meetup? I would love to hear what confused you, what you would skip, and what you wish was here.</p>
		<p><a class="btn" href={site.feedbackUrl}>Send feedback</a></p>
	</section>
</main>

<script>
	import { pickGoals } from '../preview/picker';
	const main = document.getElementById('main')!;
	const D = JSON.parse(main.dataset.v4!);
	const $ = (id: string) => document.getElementById(id)!;
	const get = (k: string) => { try { return localStorage.getItem(k) || ''; } catch { return ''; } };
	const set = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };
	const del = (k: string) => { try { localStorage.removeItem(k); } catch {} };
	const esc = (t: string) => String(t).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
	del('aip-route');
	// One goal only. Older visits may have saved a list; keep the first one we still know.
	let picked = '';
	let answer = '';
	try { const g = JSON.parse(get('aip-goals') || '[]'); const first = (Array.isArray(g) ? g : [g]).find((x: string) => pickGoals.some((p) => p.id === x)); picked = first ?? ''; } catch {}

	function show(step: 'step1' | 'step2' | 'ticket', focus = true) {
		for (const s of ['step1', 'step2', 'ticket']) { const el = $(s); el.hidden = s !== step; el.classList.toggle('enter', s === step); }
		if (focus) {
			const h = $(step).querySelector<HTMLElement>('h2, #tk-name');
			h?.focus({ preventScroll: true });
			// The steps differ in height, so bring the new one into view instead of leaving the reader mid-page.
			const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
			$(step).scrollIntoView({ block: 'start', behavior: smooth ? 'smooth' : 'auto' });
		}
	}
	// Map and stops stay hidden until a lane is chosen.
	function reveal(on: boolean) {
		$('map').hidden = !on;
		$('stops').hidden = !on;
		$('teaser').hidden = on;
		if (!on) {
			main.classList.remove('chosen-line');
			document.querySelectorAll<Element>('.ln, .mh').forEach((g) => g.classList.remove('on', 'draw'));
			document.querySelectorAll<HTMLElement>('.keys li').forEach((k) => k.classList.remove('off'));
		}
	}
	function syncGoals() {
		document.querySelectorAll<HTMLButtonElement>('.goal').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.goal === picked)));
	}
	function step2() {
		const g = pickGoals.find((x) => x.id === picked); if (!g) { show('step1'); return; }
		const ul = $('stories'); ul.innerHTML = '';
		for (const a of g.answers) {
			const L = D.lines[a.lane];
			const li = document.createElement('li');
			const b = document.createElement('button'); b.type = 'button'; b.className = 'story lift';
			b.style.setProperty('--c', L.color);
			b.innerHTML = `<span class="sw" aria-hidden="true"></span><span><q>${esc(a.text)}</q><span class="mono rec">Recommends: ${esc(L.word)} line, ${esc(L.name)}</span></span>`;
			b.addEventListener('click', () => { answer = a.text; choose(a.lane, true); });
			li.append(b); ul.append(li);
		}
		show('step2');
	}
	document.querySelectorAll<HTMLButtonElement>('.goal').forEach((b) => b.addEventListener('click', () => {
		picked = b.dataset.goal!; syncGoals(); step2();
	}));
	$('back1').addEventListener('click', () => show('step1'));
	$('tk-over').addEventListener('click', () => {
		picked = ''; answer = '';
		for (const k of ['aip-path', 'aip-goals', 'aip-world', 'aip-answer']) del(k);
		document.querySelectorAll<HTMLButtonElement>('.chip').forEach((c) => c.setAttribute('aria-pressed', 'false'));
		syncGoals(); reveal(false);
		show('step1', false);
		($('step1').querySelector('h2') as HTMLElement).focus({ preventScroll: true });
		const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
		$('plan').scrollIntoView({ block: 'start', behavior: smooth ? 'smooth' : 'auto' });
	});
	document.querySelectorAll<HTMLButtonElement>('.chip').forEach((b) => b.addEventListener('click', () => choose(b.dataset.line!, true, false)));

	function choose(lineId: string, fresh: boolean, scroll = true) {
		const L = D.lines[lineId]; if (!L) { show('step1', false); return; }
		const g = pickGoals.find((x) => x.id === picked);
		const gs = g ? [g] : [];
		const world = g?.world ?? 'everyday';
		if (fresh) { set('aip-path', lineId); set('aip-goals', JSON.stringify(picked ? [picked] : [])); set('aip-world', world); if (answer) set('aip-answer', answer); }
		const said = (answer && g?.answers.find((a) => a.text === answer && a.lane === lineId)) ? answer : L.story;
		const keys = new Set<number>(gs.flatMap((g) => g.targets));
		$('tk-band').style.setProperty('--c', L.color); $('tk-band').style.setProperty('--k', L.ink);
		$('tk-name').textContent = `${L.word} line: ${L.name}`;
		$('tk-skip').hidden = true;
		$('tk-from').textContent = said;
		$('tk-to').textContent = gs.length ? gs.map((g) => g.label).join('; ') : 'Your own pick';
		const mins = L.lessons.reduce((t: number, n: number) => t + (D.lessons[n].minutes || 10), 0);
		$('tk-meta').textContent = `${L.lessons.length} stops · about ${mins} minutes in all`;
		document.querySelectorAll<HTMLButtonElement>('.chip').forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.line === lineId)));
		// Stops
		const ol = $('vlist'); ol.innerHTML = '';
		ol.style.setProperty('--c', L.color);
		L.lessons.forEach((n: number, i: number) => {
			const l = D.lessons[n];
			const li = document.createElement('li'); li.className = 'vs'; li.style.setProperty('--i', String(i));
			const pid = `sp-${n}`;
			li.innerHTML = `<span class="vdot" aria-hidden="true"></span><div class="txt"><button type="button" class="stopb" aria-expanded="false" aria-controls="${pid}"><span class="t">${esc(l.title)}</span>${l.href ? '<span class="ready mono">Sample ready</span>' : ''}<span class="i">${esc(l.idea)}</span>${keys.has(n) ? '<span class="key mono">Key for your goal</span>' : ''}</button>${l.href ? `<a class="rs" href="${l.href}">Read sample</a>` : ''}<div class="sp" id="${pid}"><div><p class="mono">${l.minutes || 10} min</p>${l.covers.length ? `<ul>${l.covers.map((c: string) => `<li>${esc(c)}</li>`).join('')}</ul>` : ''}${l.href ? '' : '<p class="mono soon">Coming soon</p>'}</div></div></div>`;
			const b = li.querySelector('button')!;
			b.addEventListener('click', () => { const o = b.getAttribute('aria-expanded') === 'true'; b.setAttribute('aria-expanded', String(!o)); li.classList.toggle('open', !o); });
			ol.append(li);
		});
		reveal(true);
		// Map
		main.classList.add('chosen-line');
		document.querySelectorAll<SVGGElement>('.ln').forEach((g) => {
			const on = g.dataset.line === lineId;
			g.classList.toggle('on', on);
			if (on) { g.parentNode!.append(g); g.classList.remove('draw'); try { void (g as any).getBBox(); } catch {} void (g as any).getBoundingClientRect(); g.classList.add('draw'); }
		});
		document.querySelectorAll<HTMLElement>('.mh').forEach((h) => {
			h.classList.toggle('on', h.dataset.line === lineId);
		});
		document.querySelectorAll<HTMLElement>('.keys li').forEach((k) => k.classList.toggle('off', k.dataset.line !== lineId));
		$('legend').textContent = `Your line is in color. The other lines are grey.`;
		const first = L.lessons.map((n: number) => D.lessons[n]).find((l: any) => l.href);
		($('tk-start') as HTMLAnchorElement).href = first ? first.href : '#stops';
		($('tk-start') as HTMLAnchorElement).textContent = first ? 'Read a sample stop' : 'See your stops';
		show('ticket', fresh);
		if (fresh && scroll) $('plan').scrollIntoView({ block: 'start' });
	}

	// How it is different: flip cards
	document.querySelectorAll<HTMLButtonElement>('.flip').forEach((b) => b.addEventListener('click', () => b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'))));

	// Return visit: show the saved line directly.
	syncGoals();
	answer = get('aip-answer');
	const saved = get('aip-path');
	if (saved && D.lines[saved]) choose(saved, false); else reveal(false);
</script>
<style is:global>
	.wrap{max-width:68rem;margin:0 auto;padding:3.5rem 1.25rem}
	.hero{padding-top:4rem}
	.kicker{margin:0 0 1rem}
	.hero h1{font-size:clamp(3rem,13vw,8.5rem)}
	.tag{font-size:clamp(1.6rem,5vw,2.6rem);margin:.6rem 0 1.2rem}
	.pitch{font-size:1.25rem;max-width:36rem}
	.status{max-width:36rem;border-left:6px solid #FFD400;padding:.2rem 0 .2rem .8rem}
	.status .mono{display:block}
	h2{font-size:clamp(2rem,6vw,3.2rem);margin-bottom:1.2rem}
	h2:focus{outline:none}
	.pick{border-top:3px solid #0A0A0A}
	.goals,.stories{list-style:none;margin:0 0 1rem;padding:0;display:grid;gap:1rem;grid-template-columns:repeat(auto-fill,minmax(15rem,1fr))}
	.goal,.story,.flip{width:100%;height:100%;text-align:left;font:500 1.05rem/1.4 'Space Grotesk',sans-serif;color:#0A0A0A;background:#fff;border:3px solid #0A0A0A;box-shadow:4px 4px 0 #0A0A0A;padding:1rem;cursor:pointer;min-height:5rem}
	.lift{transition:transform .15s ease,box-shadow .15s ease,background-color .15s}
	.lift:hover:not(:disabled){transform:translate(-2px,-2px);box-shadow:6px 6px 0 #0A0A0A}
	.lift:active:not(:disabled){box-shadow:none;transform:translate(4px,4px)}
	.goal:hover{background:#FFF6C2}
	.goal[aria-pressed=true]{background:#FFD400}
	.goal:disabled,.btn:disabled{opacity:.45;cursor:not-allowed}
	.stories{grid-template-columns:repeat(auto-fill,minmax(20rem,1fr))}
	@media (max-width:30rem){.stories{grid-template-columns:1fr}}
	.story{display:flex;gap:.9rem}
	.story q{quotes:none;display:block;margin-top:.3rem}
	.sw{flex:none;width:14px;align-self:stretch;background:var(--c);outline:1px solid #0A0A0A}
	.enter{animation:stepin .35s ease both}
	@keyframes stepin{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
	.ticket{max-width:36rem;border:3px solid #0A0A0A;box-shadow:4px 4px 0 #0A0A0A;overflow:hidden}
	.ticket.enter{animation:print .5s ease-out both}
	@keyframes print{from{clip-path:inset(0 0 100% 0);transform:translateY(-10px)}to{clip-path:inset(0 0 0 0);transform:none}}
	.tk-band{padding:1rem 1.2rem;border-bottom:3px solid #0A0A0A;display:flex;flex-direction:column;background:var(--c,#fff);color:var(--k,#0A0A0A)}
	.tk-name{font-size:clamp(1.8rem,7vw,2.6rem)}
	.tk-name:focus{outline:none}
	.tk-body{padding:.4rem 1.2rem 1.2rem;border-top:3px dashed #0A0A0A;margin-top:6px}
	.tk-body p{margin:.6rem 0}
	.tk-body q{quotes:none}
	#tk-skip{font-weight:700}
	.tk-act{display:flex;flex-wrap:wrap;gap:1rem;align-items:center}
	.chips{display:flex;flex-wrap:wrap;gap:.6rem}
	.chip{font:700 .95rem/1.2 'Space Grotesk',sans-serif;min-height:44px;padding:.4rem .8rem;border:3px solid #0A0A0A;background:var(--c);color:var(--k);box-shadow:4px 4px 0 #0A0A0A;cursor:pointer;transition:transform .15s,box-shadow .15s}
	.chip:hover{transform:translate(-2px,-2px);box-shadow:6px 6px 0 #0A0A0A}
	.chip[aria-pressed=true]{box-shadow:none;transform:translate(4px,4px);outline:3px solid #0A0A0A;outline-offset:2px}
	.map{border-top:3px solid #0A0A0A}
	.lede{max-width:40rem}
	.keys{list-style:none;padding:0;margin:0 0 1rem;display:flex;flex-wrap:wrap;gap:.4rem 1.4rem;font-weight:700}
	.keys li{display:flex;align-items:center;gap:.5rem;transition:opacity .3s}
	.keys li.off{opacity:.4}
	.bar{display:inline-block;width:2.5rem;height:12px;background:var(--c);outline:1px solid #0A0A0A}
	.net{margin:0 0 2.5rem}
	.net svg{display:block;width:100%;height:auto}
	.ln .trk{stroke:var(--c);stroke-width:10;fill:none;transition:stroke .4s}
	.ln .edge{stroke:#0A0A0A;stroke-width:13;fill:none}
	.ln .dot{fill:#fff;stroke:#0A0A0A;stroke-width:4;transition:stroke .4s}
	.chosen-line .ln:not(.on) .trk{stroke:#D6D6D6}
	.chosen-line .ln:not(.on) .edge{stroke:#D6D6D6}
	.chosen-line .ln:not(.on) .dot{stroke:#D6D6D6;fill:#F2F2F2}
	.chosen-line .ln.on .trk{stroke-width:14}
	.chosen-line .ln.on .edge{stroke-width:17}
	.chosen-line .ln.on .dot{r:10px;stroke:var(--c);stroke-width:5}
	.chosen-line .ln.on[data-line=new] .dot{stroke:#0A0A0A}
	.ln.draw .trk,.ln.draw .edge{stroke-dasharray:1;animation:draw 1.1s ease-out both}
	@keyframes draw{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}
	.ln.draw .dot{transform-box:fill-box;transform-origin:center;animation:pop .3s ease-out both;animation-delay:calc(.25s + var(--i) * .08s)}
	@keyframes pop{0%{transform:scale(0)}70%{transform:scale(1.3)}100%{transform:scale(1)}}
	.chosen h3{font-size:clamp(1.8rem,5vw,2.6rem);margin-bottom:.4rem}
	.vline{list-style:none;margin:0;padding:0;max-width:44rem}
	.vs{display:flex;gap:1rem;padding:.4rem 0 .4rem 1rem;border-left:14px solid var(--c);animation:stepin .35s ease both;animation-delay:calc(var(--i) * .04s)}
	.vdot{flex:none;width:26px;height:26px;border-radius:50%;background:#fff;border:5px solid #0A0A0A;margin-left:-34px;margin-top:.6rem}
	.txt{flex:1;min-width:0}
	.stopb{display:flex;flex-direction:column;width:100%;text-align:left;font:inherit;color:#0A0A0A;background:#fff;border:3px solid transparent;padding:.4rem .6rem;cursor:pointer;transition:border-color .15s,box-shadow .15s}
	.stopb:hover,.stopb[aria-expanded=true]{border-color:#0A0A0A;box-shadow:4px 4px 0 #0A0A0A}
