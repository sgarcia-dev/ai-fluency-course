---
// One member of the cast, drawn in a wobbly hand-drawn line.
interface Props { who: 'you' | 'ai' | 'notepad' | 'checker'; size?: number; label?: string }
const { who, size = 96, label } = Astro.props;
const names = { you: 'You', ai: 'The AI', notepad: 'The Notepad', checker: 'The Checker' };
---
<svg class="pb-char" width={size} height={size} viewBox="0 0 100 100" role="img" aria-label={label ?? names[who]}>
	<g filter="url(#pb-wobble)" stroke="#1f2a37" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
		{who === 'you' && (
			<>
				<path d="M22 96 C24 70 36 62 50 62 C64 62 76 70 78 96" fill="#e9785f" />
				<circle cx="50" cy="38" r="20" fill="#f6dcc4" />
				<path d="M31 32 C34 16 62 12 70 30 C60 26 44 26 31 32Z" fill="#1f2a37" />
				<circle cx="43" cy="40" r="2" fill="#1f2a37" stroke="none" />
				<circle cx="57" cy="40" r="2" fill="#1f2a37" stroke="none" />
				<path d="M44 48 C48 52 53 52 57 48" fill="none" />
			</>
		)}
		{who === 'ai' && (
			<>
				<path d="M50 10 L50 20" fill="none" />
				<circle cx="50" cy="8" r="4" fill="#e8b23a" />
				<circle cx="50" cy="56" r="36" fill="#5fb3a8" />
				<ellipse cx="50" cy="52" rx="22" ry="15" fill="#fdf7ec" />
				<circle cx="42" cy="51" r="3" fill="#1f2a37" stroke="none" />
				<circle cx="58" cy="51" r="3" fill="#1f2a37" stroke="none" />
				<path d="M44 59 C48 62 52 62 56 59" fill="none" />
				<path d="M18 70 C10 66 8 58 12 54" fill="none" />
				<path d="M82 70 C90 66 92 58 88 54" fill="none" />
			</>
		)}
		{who === 'notepad' && (
			<>
				<path d="M20 14 L80 12 L82 90 L18 92 Z" fill="#fff6d6" />
				<path d="M30 8 L30 20 M45 8 L45 20 M60 8 L60 20 M72 8 L72 20" fill="none" />
				<path d="M28 36 L72 35 M28 50 L70 50 M28 64 L66 63 M28 78 L54 78" fill="none" stroke="#5fb3a8" />
			</>
		)}
		{who === 'checker' && (
			<>
				<circle cx="42" cy="42" r="26" fill="#fdf7ec" />
				<circle cx="42" cy="42" r="18" fill="none" stroke="#5fb3a8" />
				<path d="M33 42 L40 49 L52 35" fill="none" stroke="#2f7d4f" stroke-width="4" />
				<path d="M61 61 L86 86" fill="none" stroke-width="9" />
				<path d="M61 61 L86 86" fill="none" stroke="#e8b23a" stroke-width="4" />
			</>
		)}
	</g>
</svg>
