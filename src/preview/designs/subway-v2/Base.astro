---
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,900&family=JetBrains+Mono:wght@400;700&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body><slot /></body>
</html>
<style is:global>
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;background:#fff;color:#0A0A0A;font:1.0625rem/1.6 'Space Grotesk',system-ui,sans-serif;overflow-x:hidden}
h1,h2,h3,.display{font-family:'Fraunces',Georgia,serif;font-weight:900;font-variation-settings:'opsz' 144;letter-spacing:-.03em;line-height:1.02;margin:0}
.mono{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:.8rem;letter-spacing:.06em;text-transform:uppercase}
a{color:#0A0A0A;text-decoration-thickness:2px;text-underline-offset:3px}
a:hover{color:#1A34B0}
:focus-visible{outline:3px solid #1A34B0;outline-offset:3px}
.btn{display:inline-flex;align-items:center;gap:.5rem;min-height:44px;padding:.55rem 1.1rem;font:700 1rem/1.2 'Space Grotesk',sans-serif;color:#0A0A0A;background:#fff;border:3px solid #0A0A0A;box-shadow:4px 4px 0 #0A0A0A;text-decoration:none;cursor:pointer;border-radius:0}
.btn:hover{color:#0A0A0A;background:#FFD400}
.btn:active{box-shadow:none;transform:translate(4px,4px)}
.btn.ink{background:#0A0A0A;color:#fff}.btn.ink:hover{background:#1A34B0;color:#fff}
.linkbtn{font:inherit;background:none;border:0;padding:0;color:#0A0A0A;text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:3px;cursor:pointer}
img,svg{max-width:100%}
@media (prefers-reduced-motion: reduce){*{transition:none!important;animation:none!important;scroll-behavior:auto!important}.btn:active{transform:none}}
</style>
