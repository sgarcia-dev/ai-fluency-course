---
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Inter+Tight:wght@600;800&display=swap" rel="stylesheet" />
</head>
<body><slot /></body>
</html>
<style is:global>
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:#fff;color:#16181d;font:1.0625rem/1.6 'Atkinson Hyperlegible',system-ui,sans-serif;overflow-x:hidden}
h1,h2,h3,.sign{font-family:'Inter Tight','Atkinson Hyperlegible',system-ui,sans-serif;line-height:1.15}
a{color:#1D4ED8}
:focus-visible{outline:3px solid #111;outline-offset:3px;border-radius:4px}
img,svg{max-width:100%}
@media (prefers-reduced-motion: reduce){*{transition:none!important;animation:none!important;scroll-behavior:auto!important}}
</style>
