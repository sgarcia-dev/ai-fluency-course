---
// Eight tries: the AI is right 7 times and wrong once. A calculator is right all 8 times.
import { samples } from '../../content';
interface Props { wobble?: boolean }
const { wobble = false } = Astro.props;
const label = samples.find((s) => s.slug === 'check-it-with-real-proof')?.diagram.describe ?? '';
const fid = `dgw-${Math.random().toString(36).slice(2, 8)}`;
const W = 76, H = 62, G = 8, X0 = 6;
const tries = Array.from({ length: 8 }, (_, i) => i);
const pos = (i: number, top: number) => ({ x: X0 + (i % 4) * (W + G), y: top + Math.floor(i / 4) * (H + G) });
const AI_TOP = 72, CALC_TOP = 336;
---
<div class="dg-wrap" role="img" aria-label={label}>
	<svg class="dg" viewBox="0 0 340 500" width="100%" aria-hidden="true">
		<defs><filter id={fid}><feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="7" /><feDisplacementMap in="SourceGraphic" scale="3" /></filter></defs>
		<g filter={wobble ? `url(#${fid})` : undefined}>
			<text class="t b q" x="170" y="24" text-anchor="middle">What is 17 x 23?</text>
			<text class="t b" x="6" y="60">Ask the AI</text>
			{tries.map((i) => {
				const { x, y } = pos(i, AI_TOP);
				const ok = i < 7;
				return (
					<g>
						{!ok && <rect class="acc" x={x - 5} y={y - 5} width={W + 10} height={H + 10} />}
						<rect class={`line ${ok ? 'good-f' : 'bad-f'}`} x={x} y={y} width={W} height={H} />
						<text class="t muted" x={x + 8} y={y + 21}>Try {i + 1}</text>
						{ok
							? <path class="mark good-m" d={`M${x + 56} ${y + 13} l4 5 l8 -9`} />
							: <path class="mark bad-m" d={`M${x + 57} ${y + 9} l10 11 M${x + 67} ${y + 9} l-10 11`} />}
						<text class={`t b num ${ok ? '' : 'bad-t'}`} x={x + W / 2} y={y + 51} text-anchor="middle">{ok ? '391' : '381'}</text>
					</g>
				);
			})}
			<text class="t b bad-t" x="170" y="242" text-anchor="middle">Right 7 times. Wrong on try 8.</text>
			<rect class="acc" x="70" y="256" width="200" height="34" />
			<text class="t b big" x="170" y="280" text-anchor="middle">Which try is today?</text>
			<text class="t b" x="6" y="324">Ask a calculator</text>
			{tries.map((i) => {
				const { x, y } = pos(i, CALC_TOP);
				return (
					<g>
						<rect class="line good-f" x={x} y={y} width={W} height={H} />
						<text class="t muted" x={x + 8} y={y + 21}>Try {i + 1}</text>
						<path class="mark good-m" d={`M${x + 56} ${y + 13} l4 5 l8 -9`} />
						<text class="t b num" x={x + W / 2} y={y + 51} text-anchor="middle">391</text>
					</g>
				);
			})}
			<text class="t b good-t" x="170" y="492" text-anchor="middle">391 every time</text>
		</g>
	</svg>
</div>
<style>
	.dg-wrap { max-width: 30rem; margin: 0 auto; font-family: var(--dg-font, system-ui, sans-serif); }
	.dg { display: block; width: 100%; height: auto; }
	.line { stroke: var(--dg-ink, #1f2a37); stroke-width: var(--dg-stroke, 2.5); stroke-linecap: round; stroke-linejoin: round; fill: none; }
	.acc { fill: var(--dg-accent, #f2c14e); }
	.good-f { fill: var(--dg-paper, #fff); stroke: var(--dg-good, #2e8b57); }
	.bad-f { fill: var(--dg-paper, #fff); stroke: var(--dg-bad, #c0392b); stroke-width: 4; }
	.mark { fill: none; stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; }
	.good-m { stroke: var(--dg-good, #2e8b57); }
	.bad-m { stroke: var(--dg-bad, #c0392b); }
	.t { fill: var(--dg-ink, #1f2a37); font-size: 16px; font-family: var(--dg-font, system-ui, sans-serif); }
	.q { font-size: 20px; }
	.big { font-size: 19px; }
	.num { font-size: 24px; }
	.b { font-weight: 700; }
	.muted { fill: var(--dg-muted, #5b6573); font-size: 15px; }
	.good-t { fill: var(--dg-good, #2e8b57); }
	.bad-t { fill: var(--dg-bad, #c0392b); }
	rect { rx: var(--dg-radius, 8px); }
</style>
