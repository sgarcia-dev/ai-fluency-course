---
// Plan, act, check: the loop with its real exit test, and the two places you step in.
import { samples } from '../../content';
interface Props { wobble?: boolean }
const { wobble = false } = Astro.props;
const label = samples.find((s) => s.slug === 'plan-act-check')?.diagram.describe ?? '';
const fid = `dgw-${Math.random().toString(36).slice(2, 8)}`;
const x = 220; // center column
const steps = [{ t: 'Plan', y: 20 }, { t: 'Act', y: 100 }, { t: 'Check', y: 180 }];
---
<div class="dg-wrap" role="img" aria-label={label}>
	<svg class="dg" viewBox="0 0 470 430" width="100%" aria-hidden="true">
		<defs><filter id={fid}><feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="5" /><feDisplacementMap in="SourceGraphic" scale="3" /></filter></defs>
		<g filter={wobble ? `url(#${fid})` : undefined}>
			{steps.map((s) => (<g><rect class="paper line" x={x - 70} y={s.y} width="140" height="46" /><text class="t b" x={x} y={s.y + 30} text-anchor="middle">{s.t}</text></g>))}
			<path class="line" d={`M${x} 66 L${x} 90`} /><polygon class="ink" points={`${x},98 ${x - 7},86 ${x + 7},86`} />
			<path class="line" d={`M${x} 146 L${x} 170`} /><polygon class="ink" points={`${x},178 ${x - 7},166 ${x + 7},166`} />
			<path class="line" d={`M${x} 226 L${x} 244`} /><polygon class="ink" points={`${x},252 ${x - 7},240 ${x + 7},240`} />
			<!-- decision -->
			<polygon class="acc line" points={`${x},252 ${x + 80},295 ${x},338 ${x - 80},295`} />
			<text class="t b" x={x} y="301" text-anchor="middle">Passes?</text>
			<!-- yes -->
			<path class="good-l" d={`M${x} 338 L${x} 370`} /><polygon class="good" points={`${x},380 ${x - 8},366 ${x + 8},366`} />
			<text class="t b good-t" x={x + 10} y="362">Yes</text>
			<rect class="good line" x={x - 70} y="380" width="140" height="44" />
			<text class="t b w" x={x} y="409" text-anchor="middle">Done</text>
			<!-- no: back to plan with the error -->
			<path class="bad-l" d={`M${x - 80} 295 L50 295 L50 43 L${x - 82} 43`} />
			<polygon class="bad" points={`${x - 72},43 ${x - 86},36 ${x - 86},50`} />
			<text class="t b bad-t" x="62" y="285">No</text>
			<text class="t bad-t" transform="translate(40 250) rotate(-90)">error feeds next plan</text>
			<!-- you flags -->
			<path class="line thin" d={`M${x + 70} 43 L320 43`} />
			<rect class="you line thin" x="320" y="14" width="146" height="58" />
			<text class="t b" x="330" y="38">You:</text><text class="t" x="330" y="60">approve plan</text>
			<path class="line thin" d={`M${x + 70} 203 L320 203`} />
			<rect class="you line thin" x="320" y="174" width="146" height="58" />
			<text class="t b" x="330" y="198">You:</text><text class="t" x="330" y="220">write the check</text>
			<!-- off track -->
			<path class="bad-l dash" d={`M${x + 80} 295 L330 295`} />
			<text class="t b bad-t" x="336" y="280">Same error</text>
			<text class="t b bad-t" x="336" y="300">twice? Stop,</text>
			<text class="t b bad-t" x="336" y="320">narrow it.</text>
		</g>
	</svg>
</div>
<style>
	.dg-wrap { max-width: 36rem; font-family: var(--dg-font, system-ui, sans-serif); }
	.dg { display: block; width: 100%; height: auto; }
	.line { stroke: var(--dg-ink, #1f2a37); stroke-width: var(--dg-stroke, 2.5); stroke-linecap: round; stroke-linejoin: round; fill: none; }
	.thin { stroke-width: 1.5; }
	.good-l { stroke: var(--dg-good, #2e8b57); stroke-width: 3.5; fill: none; }
	.bad-l { stroke: var(--dg-bad, #c0392b); stroke-width: 3.5; fill: none; stroke-linejoin: round; }
	.dash { stroke-dasharray: 6 6; }
	.paper { fill: var(--dg-paper, #fff); }
	.acc { fill: var(--dg-paper, #fff); }
	.you { fill: var(--dg-accent, #f2c14e); }
	.ink { fill: var(--dg-ink, #1f2a37); }
	.good { fill: var(--dg-good, #2e8b57); }
	.bad { fill: var(--dg-bad, #c0392b); }
	.t { fill: var(--dg-ink, #1f2a37); font-size: 17px; font-family: var(--dg-font, system-ui, sans-serif); }
	.b { font-weight: 700; }
	.w { fill: var(--dg-paper, #fff); }
	.good-t { fill: var(--dg-good, #2e8b57); }
	.bad-t { fill: var(--dg-bad, #c0392b); }
	rect { rx: var(--dg-radius, 8px); }
</style>
