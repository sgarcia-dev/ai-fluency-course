---
// Same confident meter on both answers. Only the outside check differs.
import { samples } from '../../content';
interface Props { wobble?: boolean }
const { wobble = false } = Astro.props;
const label = samples.find((s) => s.slug === 'sure-of-itself-still-wrong')?.diagram.describe ?? '';
const fid = `dgw-${Math.random().toString(36).slice(2, 8)}`;
const cards = [
	{ x: 10, city: 'Canberra', ok: true },
	{ x: 190, city: 'Sydney', ok: false },
];
---
<svg class="dg" viewBox="0 0 360 330" width="100%" role="img" aria-label={label}>
	<defs>
		<filter id={fid}><feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="3" /><feDisplacementMap in="SourceGraphic" scale="3" /></filter>
	</defs>
	<g filter={wobble ? `url(#${fid})` : undefined}>
		<text class="t b" x="180" y="22" text-anchor="middle">Two AI answers</text>
		{cards.map((c) => (
			<g>
				<rect class="paper line" x={c.x} y="36" width="160" height="150" />
				<text class="t b big" x={c.x + 80} y="72" text-anchor="middle">{c.city}</text>
				<text class="t" x={c.x + 80} y="96" text-anchor="middle">is the capital</text>
				<text class="t" x={c.x + 80} y="118" text-anchor="middle">of Australia.</text>
				<text class="t muted" x={c.x + 80} y="148" text-anchor="middle">Sounds sure: 100%</text>
				<rect class="acc line" x={c.x + 14} y="158" width="132" height="16" />
				<text class="t b" x={c.x + 80} y="230" text-anchor="middle">{c.ok ? 'Right' : 'Wrong'}</text>
				<circle class={c.ok ? 'good line' : 'bad line'} cx={c.x + 80} cy="276" r="28" />
				<path class="mark" d={c.ok ? `M${c.x + 66} 277 l10 11 l18 -22` : `M${c.x + 68} 264 l24 24 M${c.x + 92} 264 l-24 24`} />
			</g>
		))}
		<line class="line dash" x1="10" y1="202" x2="350" y2="202" />
		<text class="t muted" x="180" y="324" text-anchor="middle">Checked against an atlas</text>
	</g>
</svg>
<style>
	.dg { display: block; width: 100%; height: auto; font-family: var(--dg-font, system-ui, sans-serif); }
	.line { stroke: var(--dg-ink, #1f2a37); stroke-width: var(--dg-stroke, 2.5); stroke-linecap: round; stroke-linejoin: round; }
	.dash { stroke-dasharray: 4 6; stroke: var(--dg-muted, #5b6573); }
	.paper { fill: var(--dg-paper, #fff); }
	.acc { fill: var(--dg-accent, #f2c14e); }
	.good { fill: var(--dg-good, #2e8b57); }
	.bad { fill: var(--dg-bad, #c0392b); }
	.mark { fill: none; stroke: var(--dg-paper, #fff); stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; }
	.t { fill: var(--dg-ink, #1f2a37); font-size: 17px; }
	.big { font-size: 22px; }
	.b { font-weight: 700; }
	.muted { fill: var(--dg-muted, #5b6573); }
	rect { rx: var(--dg-radius, 8px); }
</style>
