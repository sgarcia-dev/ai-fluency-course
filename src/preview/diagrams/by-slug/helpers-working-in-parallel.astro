---
// Split, run side by side, merge with a check. Plus the time saved.
import { samples } from "../../content";
interface Props { wobble?: boolean }
const { wobble = false } = Astro.props;
const label = samples.find((s) => s.slug === 'helpers-working-in-parallel')?.diagram.describe ?? '';
const fid = `dgw-${Math.random().toString(36).slice(2, 8)}`;
const xs = [20, 125, 230];
---
<div class="dg-wrap" role="img" aria-label={label}>
	<svg class="dg" viewBox="0 0 340 430" width="100%" aria-hidden="true">
		<defs><filter id={fid}><feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="5" /><feDisplacementMap in="SourceGraphic" scale="3" /></filter></defs>
		<g filter={wobble ? `url(#${fid})` : undefined}>
			<rect class="acc line" x="95" y="8" width="150" height="40" />
			<text class="t b" x="170" y="34" text-anchor="middle">Big job</text>
			{xs.map((x, i) => (
				<g>
					<path class="line" d={`M170 48 L${x + 45} 82`} />
					<rect class="good line" x={x} y="82" width="90" height="40" />
					<text class="t b w" x={x + 45} y="108" text-anchor="middle">Helper {i + 1}</text>
					<path class="line" d={`M${x + 45} 122 L170 158`} />
				</g>
			))}
			<rect class="paper line" x="80" y="158" width="180" height="42" />
			<text class="t b" x="160" y="185" text-anchor="middle">Merge + check</text>
			<circle class="good line" cx="240" cy="179" r="11" />
			<path class="tick" d="M234 179 l4 4 l8 -9" />

			<path class="line dash" d="M10 228 L330 228" />
			<text class="t b" x="20" y="262">One after another</text>
			<rect class="soft line" x="20" y="274" width="98" height="30" />
			<rect class="soft line" x="120" y="274" width="98" height="30" />
			<rect class="soft line" x="220" y="274" width="98" height="30" />
			<text class="t b" x="20" y="340">Side by side</text>
			{[0, 1, 2].map((i) => (<rect class="good line" x="20" y={352 + i * 18} width="98" height="14" />))}
			<path class="line" d="M124 350 L124 406" stroke-dasharray="4 4" />
			<text class="t b good-t" x="134" y="386">done 3x sooner</text>
		</g>
	</svg>
</div>
<style>
	.dg-wrap { max-width: 32rem; font-family: var(--dg-font, system-ui, sans-serif); }
	.dg { display: block; width: 100%; height: auto; }
	.line { stroke: var(--dg-ink, #1f2a37); stroke-width: var(--dg-stroke, 2.5); stroke-linecap: round; stroke-linejoin: round; fill: none; }
	.dash { stroke-dasharray: 5 6; stroke: var(--dg-muted, #5b6573); }
	.paper { fill: var(--dg-paper, #fff); }
	.acc { fill: var(--dg-accent, #f2c14e); }
	.good { fill: var(--dg-good, #2e8b57); }
	.bad { fill: var(--dg-bad, #c0392b); }
	.soft { fill: var(--dg-muted, #5b6573); opacity: 0.3; }
	.tick { fill: none; stroke: var(--dg-paper, #fff); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
	.t { fill: var(--dg-ink, #1f2a37); font-size: 17px; font-family: var(--dg-font, system-ui, sans-serif); }
	.b { font-weight: 700; }
	.w { fill: var(--dg-paper, #fff); }
	.muted { fill: var(--dg-muted, #5b6573); }
	.good-t { fill: var(--dg-good, #2e8b57); }
	.bad-t { fill: var(--dg-bad, #c0392b); }
	rect { rx: var(--dg-radius, 8px); }
</style>
