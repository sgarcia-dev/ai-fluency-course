---
// The three parts of a good ask, as a fill-in card.
import { samples } from '../../content';
interface Props { wobble?: boolean }
const { wobble = false } = Astro.props;
const label = samples.find((s) => s.slug === 'say-what-done-looks-like')?.figures?.find((f) => f.id === 'three')?.describe ?? '';
const fid = `dgw-${Math.random().toString(36).slice(2, 8)}`;
const rows = [
	{ k: 'What', v: 'A note to move my checkup' },
	{ k: 'Who it is for', v: 'The front desk' },
	{ k: 'Done when', v: 'Under 100 words, has the date' },
];
---
<div class="dg-one" role="img" aria-label={label}>
	<svg class="dg" viewBox="0 0 320 250" width="100%" aria-hidden="true">
		<defs><filter id={fid}><feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="5" /><feDisplacementMap in="SourceGraphic" scale="3" /></filter></defs>
		<g filter={wobble ? `url(#${fid})` : undefined}>
			<rect class="paper line" x="6" y="6" width="308" height="238" />
			{rows.map((r, i) => (
				<g>
					<text class={i === 2 ? 't b acc-t' : 't b'} x="22" y={40 + i * 76}>{r.k}</text>
					<rect class={i === 2 ? 'acc line thin' : 'soft line thin'} x="22" y={50 + i * 76} width="276" height="36" />
					<text class="t" x="34" y={74 + i * 76}>{r.v}</text>
				</g>
			))}
		</g>
	</svg>
</div>
<style>
	.dg-one { max-width: 26rem; margin: 0 auto; font-family: var(--dg-font, system-ui, sans-serif); }
	.dg { display: block; width: 100%; height: auto; }
	.line { stroke: var(--dg-ink, #1f2a37); stroke-width: var(--dg-stroke, 2.5); stroke-linecap: round; stroke-linejoin: round; fill: none; }
	.thin { stroke-width: 1.5; }
	.paper { fill: var(--dg-paper, #fff); }
	.soft { fill: var(--dg-paper, #fff); stroke-dasharray: 4 4; }
	.acc { fill: var(--dg-accent, #f2c14e); }
	.t { fill: var(--dg-ink, #1f2a37); font-size: 17px; font-family: var(--dg-font, system-ui, sans-serif); }
	.b { font-weight: 700; }
	.acc-t { fill: var(--dg-ink, #1f2a37); }
	rect { rx: var(--dg-radius, 8px); }
</style>
