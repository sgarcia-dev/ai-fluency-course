---
// One comparison: a plain ask and an explicit (yellow) ask, and the reply each one gets.
import { samples } from '../../content';
interface Props { wobble?: boolean }
const { wobble = false } = Astro.props;
const label = samples.find((s) => s.slug === 'say-what-done-looks-like')?.diagram.describe ?? '';
const fid = `dgw-${Math.random().toString(36).slice(2, 8)}`;
const spec = [
	['For:', 'my team'],
	['Tone:', 'calm, direct'],
	['Include:', 'new date, why'],
	['Leave out:', 'client blame'],
	['Length:', 'under 80 words'],
	['End:', 'what I need'],
];
const longBars = [250, 230, 255, 210, 245, 225, 240, 150];
const R = 248; // y where both replies start
---
<div class="dg-pair" role="img" aria-label={label}>
	<svg class="dg" viewBox="0 0 300 450" width="100%" aria-hidden="true">
		<defs><filter id={fid}><feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="5" /><feDisplacementMap in="SourceGraphic" scale="3" /></filter></defs>
		<g filter={wobble ? `url(#${fid})` : undefined}>
			<text class="t b" x="10" y="22">Plain ask</text>
			<rect class="paper line" x="10" y="34" width="280" height="80" />
			<text class="t" x="24" y="60">"Write a message to my</text>
			<text class="t" x="24" y="82">team about the deadline</text>
			<text class="t" x="24" y="104">moving."</text>
			<path class="line" d="M150 124 L150 236" />
			<polygon class="ink line" points="150,242 143,230 157,230" />
			<rect class="paper line" x="10" y={R} width="280" height="160" />
			<text class="t muted" x="24" y={R + 24}>"So sorry, everyone..."</text>
			{longBars.map((w, i) => <rect class="soft" x="24" y={R + 36 + i * 14} width={w} height="7" style="rx:3px" />)}
			<text class="t b" x="150" y="440" text-anchor="middle">Okay: long, sorry, vague</text>
		</g>
	</svg>
	<svg class="dg" viewBox="0 0 300 450" width="100%" aria-hidden="true">
		<g filter={wobble ? `url(#${fid})` : undefined}>
			<text class="t b" x="10" y="22">Explicit ask</text>
			<rect class="acc line" x="10" y="34" width="280" height="190" />
			<text class="t" x="24" y="58">"Write a message to my team..."</text>
			{spec.map(([k, v], i) => (
				<g>
					<text class="t b" x="24" y={86 + i * 23}>{k}</text>
					<text class="t" x="118" y={86 + i * 23}>{v}</text>
				</g>
			))}
			<path class="line" d="M150 226 L150 236" />
			<polygon class="ink line" points="150,242 143,230 157,230" />
			<rect class="paper goodline" x="10" y={R} width="280" height="110" />
			<text class="t" x="24" y={R + 26}>New date: <tspan class="b">May 14</tspan>.</text>
			<rect class="soft" x="24" y={R + 40} width="200" height="7" style="rx:3px" />
			<rect class="soft" x="24" y={R + 54} width="160" height="7" style="rx:3px" />
			<text class="t" x="24" y={R + 92}>Can you each...?</text>
			<circle class="good" cx="262" cy={R + 84} r="16" />
			<path class="tickw" d={`M254 ${R + 84} l6 6 l10 -12`} />
			<text class="t b good-t" x="150" y="440" text-anchor="middle">Clearly better: ready to send</text>
		</g>
	</svg>
</div>
<style>
	.dg-pair { display: flex; gap: 1rem; font-family: var(--dg-font, system-ui, sans-serif); }
	.dg-pair > svg { flex: 1 1 0; min-width: 0; }
	@media (max-width: 40rem) { .dg-pair { flex-direction: column; } .dg-pair > svg { flex: none; } }
	.dg { display: block; width: 100%; height: auto; }
	.line { stroke: var(--dg-ink, #1f2a37); stroke-width: var(--dg-stroke, 2.5); stroke-linecap: round; stroke-linejoin: round; fill: none; }
	.thin { stroke-width: 1.5; }
	.dash { stroke-dasharray: 5 6; stroke: var(--dg-muted, #5b6573); }
	.paper { fill: var(--dg-paper, #fff); }
	.acc { fill: var(--dg-accent, #f2c14e); }
	.good { fill: var(--dg-good, #2e8b57); }
	.bad { fill: var(--dg-bad, #c0392b); }
	.tg { fill: var(--dg-muted, #5b6573); fill-opacity: 0.25; }
	.ink { fill: var(--dg-ink, #1f2a37); }
	.xm { fill: none; stroke: var(--dg-bad, #c0392b); stroke-width: 3.5; stroke-linecap: round; }
	.tick { fill: none; stroke: var(--dg-good, #2e8b57); stroke-width: 2.5; stroke-linecap: round; }
	.t { fill: var(--dg-ink, #1f2a37); font-size: 16px; font-family: var(--dg-font, system-ui, sans-serif); }
	.b { font-weight: 700; }
	.muted { fill: var(--dg-muted, #5b6573); }
	.good-t { fill: var(--dg-good, #2e8b57); }
	.bad-t { fill: var(--dg-bad, #c0392b); }
	rect { rx: var(--dg-radius, 8px); }
	.soft { fill: var(--dg-muted, #5b6573); opacity: 0.35; }
	.goodline { stroke: var(--dg-good, #2e8b57); stroke-width: 3.5; }
	.tickw { fill: none; stroke: var(--dg-paper, #fff); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
</style>
