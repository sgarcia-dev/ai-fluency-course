---
// Same ask, same target. Only the "Done when" checklist differs.
import { samples } from '../../content';
interface Props { wobble?: boolean }
const { wobble = false } = Astro.props;
const label = samples.find((s) => s.slug === 'say-what-done-looks-like')?.diagram.describe ?? '';
const fid = `dgw-${Math.random().toString(36).slice(2, 8)}`;
const arrow = (x1: number, y1: number, x2: number, y2: number) => {
	const a = Math.atan2(y2 - y1, x2 - x1);
	const p = (d: number, o: number) => `${x2 - Math.cos(a) * d - Math.sin(a) * o},${y2 - Math.sin(a) * d + Math.cos(a) * o}`;
	return { shaft: `M${x1},${y1} L${x2},${y2}`, head: `${x2},${y2} ${p(16, 7)} ${p(16, -7)}` };
};
const T = { cx: 200, cy: 250, r: 48 };
const rings = [1, 2 / 3, 1 / 3].map((k) => T.r * k);
const miss = arrow(30, 215, 282, 168);
const hit = arrow(30, 215, T.cx, T.cy);
const ticks = ['Under 100 words', 'Mentions the date', 'Asks to call back'];
---
<div class="dg-pair" role="img" aria-label={label}>
	<svg class="dg" viewBox="0 0 300 340" width="100%" aria-hidden="true">
		<defs><filter id={fid}><feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="5" /><feDisplacementMap in="SourceGraphic" scale="3" /></filter></defs>
		<g filter={wobble ? `url(#${fid})` : undefined}>
			<text class="t b" x="10" y="22">Vague ask</text>
			<rect class="paper line" x="10" y="34" width="170" height="54" />
			<text class="t" x="22" y="57">"Write something</text>
			<text class="t" x="22" y="78">for the doctor"</text>
			{rings.map((r, i) => <circle class={i % 2 ? 'paper line' : 'tg line'} cx={T.cx} cy={T.cy} r={r} />)}
			<path class="line" d={miss.shaft} />
			<polygon class="ink line" points={miss.head} />
			<path class="xm" d="M274 150 l16 16 M290 150 l-16 16" />
			<text class="t b bad-t" x="150" y="330" text-anchor="middle">Polished. Wrong thing.</text>
		</g>
	</svg>
	<svg class="dg" viewBox="0 0 300 340" width="100%" aria-hidden="true">
		<g filter={wobble ? `url(#${fid})` : undefined}>
			<text class="t b" x="10" y="22">Clear ask</text>
			<rect class="paper line" x="10" y="34" width="170" height="54" />
			<text class="t" x="22" y="57">"Write something</text>
			<text class="t" x="22" y="78">for the doctor"</text>
			{rings.map((r, i) => <circle class={i % 2 ? 'paper line' : 'tg line'} cx={T.cx} cy={T.cy} r={r} />)}
			<rect class="acc line" x="10" y="96" width="190" height="98" />
			<text class="t b" x="20" y="118">Done when:</text>
			{ticks.map((k, i) => (
				<g>
					<rect class="paper line thin" x="20" y={128 + i * 21} width="14" height="14" />
					<path class="tick" d={`M22 ${135 + i * 21} l4 4 l7 -9`} />
					<text class="t" x="42" y={141 + i * 21}>{k}</text>
				</g>
			))}
			<path class="line" d={hit.shaft} />
			<polygon class="ink line" points={hit.head} />
			<text class="t b good-t" x="150" y="330" text-anchor="middle">Exactly what you meant</text>
		</g>
	</svg>
</div>
<style>
	.dg-pair { display: flex; gap: 1rem; font-family: var(--dg-font, system-ui, sans-serif); }
	.dg-pair > svg { flex: 1 1 0; min-width: 0; }
	@media (max-width: 40rem) { .dg-pair { flex-direction: column; } .dg-pair > svg { flex: none; } }
	.dg { display: block; width: 100%; height: auto; }
	.line { stroke: var(--dg-ink, #1f2a37); stroke-width: var(--dg-stroke, 2.5); stroke-linecap: round; stroke-linejoin: round; fill: none; }
	.thin { stroke-width: 1.5; }
	.dash { stroke-dasharray: 5 6; stroke: var(--dg-muted, #5b6573); }
	.paper { fill: var(--dg-paper, #fff); }
	.acc { fill: var(--dg-accent, #f2c14e); }
	.good { fill: var(--dg-good, #2e8b57); }
	.bad { fill: var(--dg-bad, #c0392b); }
	.tg { fill: var(--dg-muted, #5b6573); fill-opacity: 0.25; }
	.ink { fill: var(--dg-ink, #1f2a37); }
	.xm { fill: none; stroke: var(--dg-bad, #c0392b); stroke-width: 3.5; stroke-linecap: round; }
	.tick { fill: none; stroke: var(--dg-good, #2e8b57); stroke-width: 2.5; stroke-linecap: round; }
	.t { fill: var(--dg-ink, #1f2a37); font-size: 16px; font-family: var(--dg-font, system-ui, sans-serif); }
	.b { font-weight: 700; }
	.muted { fill: var(--dg-muted, #5b6573); }
	.good-t { fill: var(--dg-good, #2e8b57); }
	.bad-t { fill: var(--dg-bad, #c0392b); }
	rect { rx: var(--dg-radius, 8px); }
</style>
