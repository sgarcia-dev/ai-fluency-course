---
// Next-word options as bars: it picks what sounds likely, not what is checked.
import { samples } from '../../content';
interface Props { wobble?: boolean }
const { wobble = false } = Astro.props;
const label = samples.find((s) => s.slug === 'sure-of-itself-still-wrong')?.figures?.find((f) => f.id === 'why')?.describe ?? '';
const fid = `dgw-${Math.random().toString(36).slice(2, 8)}`;
const bars = [
	{ w: 'Sydney', h: 170, cls: 'bad' },
	{ w: 'Canberra', h: 100, cls: 'good' },
	{ w: 'Melbourne', h: 45, cls: 'muted-fill' },
];
---
<svg class="dg" viewBox="0 0 360 330" width="100%" role="img" aria-label={label}>
	<defs>
		<filter id={fid}><feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="4" /><feDisplacementMap in="SourceGraphic" scale="3" /></filter>
	</defs>
	<g filter={wobble ? `url(#${fid})` : undefined}>
		<text class="t b" x="180" y="26" text-anchor="middle">"The capital of Australia is..."</text>
		<text class="t muted" x="180" y="52" text-anchor="middle">How likely each next word sounds</text>
		{bars.map((b, i) => (
			<g>
				<rect class={`${b.cls} line`} x={30 + i * 110} y={260 - b.h} width="80" height={b.h} />
				<text class="t b" x={70 + i * 110} y="286" text-anchor="middle">{b.w}</text>
			</g>
		))}
		<line class="line" x1="16" y1="260" x2="344" y2="260" />
		<text class="t b acc-t" x="70" y="80" text-anchor="middle">Picked</text>
		<text class="t b bad-t" x="180" y="318" text-anchor="middle">Sounds likely, but not true</text>
	</g>
</svg>
<style>
	.dg { display: block; width: 100%; height: auto; font-family: var(--dg-font, system-ui, sans-serif); }
	.line { stroke: var(--dg-ink, #1f2a37); stroke-width: var(--dg-stroke, 2.5); stroke-linecap: round; stroke-linejoin: round; }
	.good { fill: var(--dg-good, #2e8b57); }
	.bad { fill: var(--dg-bad, #c0392b); }
	.muted-fill { fill: var(--dg-muted, #5b6573); fill-opacity: 0.4; }
	.t { fill: var(--dg-ink, #1f2a37); font-size: 17px; }
	.b { font-weight: 700; }
	.muted { fill: var(--dg-muted, #5b6573); }
	.acc-t { fill: var(--dg-ink, #1f2a37); text-decoration: underline; }
	.bad-t { fill: var(--dg-bad, #c0392b); }
	rect { rx: var(--dg-radius, 8px); }
</style>
