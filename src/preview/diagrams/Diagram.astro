---
// Renders the drawn diagram for a lesson slug, or nothing if none exists.
// Each diagram lives in ./by-slug/<lesson slug>.astro and takes an optional `wobble` prop.
interface Props { slug: string; wobble?: boolean }
const { slug, wobble = false } = Astro.props;
const diagrams = import.meta.glob<{ default: any }>('./by-slug/*.astro', { eager: true });
const Drawn = diagrams[`./by-slug/${slug}.astro`]?.default;
---
{Drawn && <Drawn wobble={wobble} />}
